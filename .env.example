# 배포 주소 (공유 링크·OG 이미지·sitemap 에 사용). 끝에 / 없이
NEXT_PUBLIC_BASE_URL=https://viral-quit-test.vercel.app

# Supabase — 비워두면 인메모리 Mock 저장소로 동작(개발용, 데이터 유지 안 됨)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 를 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — 비워두면 Mock 사직서로 동작. 서버 전용
GEMINI_API_KEY=

# 카카오 JavaScript 키 (브라우저 공개용, 카카오 콘솔에서 사이트 도메인 제한 필수)
NEXT_PUBLIC_KAKAO_JS_KEY=
# 카카오 개발자 사이트 > JavaScript SDK 다운로드에서 2.7.4 의 integrity 값을 복사 (sha384-...)
NEXT_PUBLIC_KAKAO_SDK_INTEGRITY=
